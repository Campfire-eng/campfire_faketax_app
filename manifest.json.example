{
  "app": {
    "name": "FakeTax",
    "tagline": "Made-up sales tax on invoices",
    "category": "tax",
    "description": "Sales tax for invoices and credit memos by jurisdiction, with tax codes on lines. The tax is fake; the plumbing is real.",
    "icon_url": null,
    "redirect_uris": [
      "<APP_URL>/callback"
    ],
    "connect_url": "<APP_URL>/connect",
    "allowed_scopes": [
      "openid",
      "email",
      "profile",
      "invoices:read",
      "invoices:write",
      "credit_memos:write",
      "custom_fields:write",
      "vendors:read"
    ],
    "manage_url": "<APP_URL>/manage"
  },
  "allowed_domains": [
    "<APP_DOMAIN>"
  ],
  "slots": [
    {
      "key": "view",
      "label": "View in FakeTax",
      "icon": "external-link",
      "object_type": "invoice",
      "surface": "detail_header",
      "requested_variant": "menu",
      "action_type": "link",
      "action_config": {
        "url_template": "<APP_URL>/report/{{record.id}}"
      },
      "visible_when": [],
      "confirm_text": "",
      "order": 2,
      "is_active": true
    },
    {
      "key": "calculate",
      "label": "Calculate tax",
      "icon": "calculator",
      "object_type": "invoice",
      "surface": "detail_header",
      "requested_variant": "secondary",
      "action_type": "webhook",
      "action_config": {
        "url_template": "<APP_URL>/slots/calculate",
        "timeout_ms": 8000
      },
      "visible_when": [
        {
          "field": "payment_status",
          "op": "in",
          "value": [
            "draft",
            "open"
          ]
        }
      ],
      "confirm_text": "Overwrite tax on every line?",
      "order": 0,
      "is_active": true
    },
    {
      "key": "calculate-bulk",
      "label": "Calculate FakeTax",
      "icon": "calculator",
      "object_type": "invoice",
      "surface": "list_header",
      "requested_variant": "menu",
      "action_type": "webhook",
      "action_config": {
        "url_template": "<APP_URL>/slots/calculate",
        "timeout_ms": 8000
      },
      "visible_when": [],
      "confirm_text": "",
      "order": 0,
      "is_active": true
    },
    {
      "key": "open-row",
      "label": "FakeTax report",
      "icon": "external-link",
      "object_type": "invoice",
      "surface": "row_menu",
      "requested_variant": "menu",
      "action_type": "link",
      "action_config": {
        "url_template": "<APP_URL>/report/{{record.id}}"
      },
      "visible_when": [],
      "confirm_text": "",
      "order": 0,
      "is_active": true
    },
    {
      "key": "breakdown",
      "label": "Tax breakdown",
      "icon": "table",
      "object_type": "invoice",
      "surface": "detail_header",
      "requested_variant": "menu",
      "action_type": "iframe",
      "action_config": {
        "url_template": "<APP_URL>/frame/breakdown/{{record.id}}",
        "presentation": "drawer",
        "width": "lg"
      },
      "visible_when": [],
      "confirm_text": "",
      "order": 1,
      "is_active": true
    }
  ],
  "panels": [
    {
      "key": "breakdown-tab",
      "label": "FakeTax",
      "icon": "table",
      "object_type": "invoice",
      "placements": [
        "detail",
        "edit"
      ],
      "url_template": "<APP_URL>/frame/breakdown/{{record.id}}",
      "visible_when": [],
      "order": 0,
      "is_active": true
    },
    {
      "key": "settings",
      "label": "FakeTax",
      "icon": "settings",
      "object_type": "invoice",
      "placements": [
        "list"
      ],
      "url_template": "<APP_URL>/frame/settings",
      "visible_when": [],
      "order": 0,
      "is_active": true
    }
  ],
  "navigation": [
    {
      "key": "faketax",
      "label": "FakeTax",
      "icon": "calculator",
      "url_template": "",
      "is_active": true,
      "items": [
        {
          "key": "jurisdictions",
          "label": "Jurisdictions",
          "icon": "map-pin",
          "url_template": "<APP_URL>/frame/manage",
          "is_active": true
        },
        {
          "key": "tax-codes",
          "label": "Tax codes",
          "icon": "tag",
          "url_template": "<APP_URL>/frame/codes",
          "is_active": true
        },
        {
          "key": "settings",
          "label": "Settings",
          "icon": "settings",
          "url_template": "<APP_URL>/frame/settings",
          "is_active": true
        }
      ]
    }
  ],
  "event_subscriptions": [
    {
      "topics": [
        "Invoice.created",
        "Invoice.updated",
        "Invoice.deleted",
        "CreditMemo.created",
        "CreditMemo.updated"
      ],
      "endpoint_url": "<APP_URL>/events",
      "is_active": true
    }
  ]
}